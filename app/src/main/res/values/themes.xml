<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole UI, so the platform theme only needs to supply a
         window background and get out of the way until the first frame. -->
    <style name="Theme.GuitarSalmon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
